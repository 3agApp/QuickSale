<?xml version="1.0" encoding="utf-8"?>
<!--
   Cleartext is permitted, because a store URL may legitimately be an http:// one: a
   proxied or LAN-only WooCommerce install that serves no TLS at all. Settings makes
   that an explicit choice — the scheme is a control next to the URL field, https by
   default, and picking http says so in red right under it.

   The trust anchors below apply whenever Settings' "Allow insecure connection" switch
   is off. With it on — the default, because the fleet's terminals need it — InsecureTls
   replaces the trust manager and certificates are not validated at all. See its KDoc.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
