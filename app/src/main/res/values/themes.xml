<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.QuickSale" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- System splash screen (Android 12+, backported by androidx.core.splashscreen down to our
         minSdk). Scoped to MainActivity only — QrCaptureActivity must keep inheriting the plain
         app theme, not this one. Handed off to Theme.QuickSale once the first frame is ready. -->
    <style name="Theme.QuickSale.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.QuickSale</item>
    </style>
</resources>